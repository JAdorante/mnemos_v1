{
  "$id": "sparrow/claims/project_note",
  "version": "project_note-v1",
  "description": "A note a person reviewed and shared with a project. predicate is 'noted'.",
  "type": "object",
  "properties": {
    "text": {"type": "string", "minLength": 1, "maxLength": 8000},
    "title": {"type": "string", "maxLength": 200},
    "note_kind": {"type": "string", "enum": ["decision", "requirement", "task", "fact", "idea", "question", "reference", "note"]},
    "status": {"type": "string", "enum": ["decided", "suggested", ""]},
    "decided_by": {"type": "string", "maxLength": 200},
    "owner": {"type": "string", "maxLength": 200},
    "due": {"type": "string", "maxLength": 40},
    "rationale": {"type": "string", "maxLength": 2000},
    "source_url": {"type": "string", "maxLength": 1000},
    "drafted_by": {"type": "string", "maxLength": 80}
  },
  "required": ["text", "note_kind"],
  "additionalProperties": false
}
