{
  "$id": "sparrow/claims/field_update",
  "version": "field_update-v1",
  "description": "A value for one named field on an external object. `field` is required so a connector can map it without an LLM.",
  "type": "object",
  "properties": {
    "field": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "value": {"type": ["string", "number", "boolean", "null"]},
    "unit": {"type": "string", "maxLength": 32}
  },
  "required": ["field", "value"],
  "additionalProperties": false
}
