{
  "$id": "sparrow/claims/decision",
  "version": "decision-v1",
  "description": "A choice that was made. predicate is 'decided'.",
  "type": "object",
  "properties": {
    "text": {"type": "string", "minLength": 1, "maxLength": 500},
    "decided_by": {"type": "string", "maxLength": 200},
    "decided_on": {"type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"}
  },
  "required": ["text"],
  "additionalProperties": false
}
