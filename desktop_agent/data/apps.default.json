    "platforms": ["nt", "posix"],
    "candidates": ["%LOCALAPPDATA%\\Programs\\cursor\\Cursor.exe", "cursor"],
    "capabilities": {
      "display_name": "Cursor",
      "launch": true,
      "open_jailed_files": [".py", ".md", ".txt", ".json", ".js", ".ts", ".html", ".css"],
      "opens_dirs": true,
      "pixel_ui": "approval_required",
      "shell": "limited",
      "network": true,
      "risk": "medium",
      "demo_safe": true,
      "notes": "Code editor; opens a jailed project folder or source file."
    }
  },

