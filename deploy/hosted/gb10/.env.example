# Per-user API tokens (required) + shared secrets for the GB10 pilot.
#
#   cp .env.example .env
#   # fill tokens, then:
#   docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d --build

SPARROW_USER1_TOKEN=replace-me
SPARROW_USER2_TOKEN=replace-me
SPARROW_USER3_TOKEN=replace-me
SPARROW_USER4_TOKEN=replace-me
SPARROW_USER5_TOKEN=replace-me
SPARROW_USER6_TOKEN=replace-me

# Optional — Anthropic key for agent / cloud routing on user1
#SPARROW_ANTHROPIC_KEY=

# Google connector (Gmail + Calendar metadata). Create a Google Cloud
# **Web application** OAuth client, then register exactly ONE redirect URI:
#   https://gb10.<tailnet>.ts.net/oauth/google/callback
# That funnel hostname never changes, and the container behind it relays the
# code back to whichever quick-tunnel hostname the user started on — so a
# tunnel restart costs nothing. See README.md "Google connector".
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: Outlook connector (Microsoft Graph); same relay hostname,
# redirect URI .../oauth/outlook/callback.
#MS_OAUTH_CLIENT_ID=
#MS_OAUTH_CLIENT_SECRET=
#MS_OAUTH_TENANT=common
# Optional: GitHub / Linear / HubSpot connectors (read-only issues, PRs,
# repos; issues + projects; contacts, deals, companies). Same relay
# hostname, redirect URIs .../oauth/github/callback, .../oauth/linear/callback,
# .../oauth/hubspot/callback. Each needs a confidential client (id + secret).
# See README.md "GitHub, Linear and HubSpot".
#GITHUB_OAUTH_CLIENT_ID=
#GITHUB_OAUTH_CLIENT_SECRET=
#LINEAR_OAUTH_CLIENT_ID=
#LINEAR_OAUTH_CLIENT_SECRET=
#HUBSPOT_OAUTH_CLIENT_ID=
#HUBSPOT_OAUTH_CLIENT_SECRET=
# Optional: Notion (pages + databases you share) and Slack (messages in your
# channels and DMs, as you). Callbacks .../oauth/notion/callback and
# .../oauth/slack/callback. Slack only redirects to HTTPS.
#NOTION_OAUTH_CLIENT_ID=
#NOTION_OAUTH_CLIENT_SECRET=
#SLACK_OAUTH_CLIENT_ID=
#SLACK_OAUTH_CLIENT_SECRET=
#SPARROW_OAUTH_REDIRECT_BASE=https://gb10.<tailnet>.ts.net

# Fleet federation relay (org-relay). Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_ADMIN_TOKEN=
RELAY_COMPLIANCE_TOKEN=
