# Cloudflare named-tunnel token. Zero Trust dashboard -> Networks -> Tunnels ->
# Create a tunnel -> copy the token, then add a Public Hostname:
#   sparrow.ravenry.us  ->  HTTP  ->  gateway:8080
# Cloudflare creates the DNS record for you; ravenry.us must be on Cloudflare.
TUNNEL_TOKEN=

# Leave blank for open signup. Set a shared code to gate account creation.
SIGNUP_INVITE_CODE=

# Capacity guards. Each seat runs its own ASR, so size these to the box.
MAX_SEATS=25
SEAT_MEM_LIMIT=6g
SEAT_CPUS=2

# Optional: cloud routing / browser agent for every new seat.
#SPARROW_ANTHROPIC_KEY=

# Optional: Google connector. Register exactly one redirect URI:
#   https://sparrow.ravenry.us/oauth/google/callback
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
