# Mnemos — example configuration (safe defaults).
# Copy to .env and fill in your own keys. Never commit or zip a real .env.
#
# Every value here matches the safe code default; uncommented lines are the
# only ones you must set. Capture, LAN exposure, and cloud spend all stay off
# or capped until you deliberately turn them on.

# --- Required -----------------------------------------------------------------
# Your own AI model account — Mnemos never ships with a key. Easiest path:
# connect it in Setup (/onboarding), which validates the key live and stores
# it in .credentials.env. Anthropic is the default parent and the only
# provider that also powers vision escalation + browser/desktop agent tasks;
# OpenAI / Gemini / Grok parents cover chat, extraction, and briefs.
ANTHROPIC_API_KEY=
# Pilot testers: if you were given an invite code instead of a key, the
# installer exchanges it here for a key of your own and writes it to
# .credentials.env. The key then lives on YOUR machine and calls go straight to
# the provider — this endpoint is never contacted again after install.
# (WS-D Tier 1; leave blank for the bring-your-own-key path.)
#QUILL_INVITE_URL=
# Or pick a different parent (anthropic | openai | google | xai) and set its key:
#QUILL_PARENT_PROVIDER=anthropic
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#XAI_API_KEY=
# Non-Anthropic parents map tasks onto the provider's flagship/light models;
# override with one forced model, or per tier:
#QUILL_PARENT_MODEL=
#QUILL_PARENT_MODEL_FLAGSHIP=
#QUILL_PARENT_MODEL_LIGHT=

# --- Network (loopback by default) ---------------------------------------------
# 127.0.0.1 = this machine only (safe default). Set 0.0.0.0 to allow phones /
# other devices on your LAN — if you do, you MUST also set QUILL_API_TOKEN,
# and unlock browsers at http://<lan-ip>:8000/auth.
#QUILL_HOST=127.0.0.1
#QUILL_API_TOKEN=
# Optional salt for the browser session cookie HMAC (plan 6.3); auto-minted
# to data/.session_salt when unset. Cookie holds HMAC(salt, token), not the token.
#QUILL_SESSION_SALT=
# CSRF Origin/token gate on POST/PUT/PATCH/DELETE (plan 6.4; default on)
#QUILL_CSRF=1

# --- Capture (all OFF until in-UI consent) --------------------------------------
# Do not set these to 1 here. Turn capture on from Privacy controls in the UI,
# which records consent first. Setting them here silently records your screen,
# microphone, and meeting audio.
#QUILL_DESKTOP_CAPTURE=0
#QUILL_SYSTEM_AUDIO=0
#QUILL_VISION=0
#QUILL_SAVE_AUDIO=0

# --- Cloud spend ---------------------------------------------------------------
# Hard USD/day cap on ambient cloud calls (vision/extract/reflect/activity).
# 0 = uncapped (never recommended). User-initiated chat is not drawn from this.
#QUILL_CLOUD_BUDGET_USD_DAY=2.0
# Don't pay for cloud vision when the local model is down — skip the frame.
#QUILL_VISION_CLOUD_WHEN_LOCAL_DOWN=0

# --- Optional integrations ------------------------------------------------------
#GOOGLE_API_KEY=

# --- Local-first text tier (requires Ollama) ------------------------------------
# With Ollama installed, answer/extract locally first and escalate to Claude
# only on low confidence. Leave off if you don't run Ollama.
#QUILL_TEXT_LOCAL=0
#QUILL_TEXT_LOCAL_MODEL=qwen2.5:7b-instruct
#QUILL_TEXT_ESCALATE_MIN_CONF=0.8

# --- Feature flags --------------------------------------------------------------
# Tester cohort preset: meeting-first, Phone Link / anticipate / desktop off.
#QUILL_PROFILE=tester
#QUILL_FIRST_RUN_MODE=meeting
#QUILL_MEETING_PAD_MIN=5
#QUILL_UNLOCK_AFTER_BRIEFS=3
# Gmail/Calendar metadata cold-start (headers + attendees only — never bodies)
#QUILL_EXHAUST_INGEST=1
#QUILL_EXHAUST_DAYS=90
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
# Read-only MCP memory server for Claude Desktop (see docs/mcp.md)
#QUILL_MCP=0
# Omi / phone-as-mic ingest
#QUILL_EXTERNAL_CAPTURE=0
# Cloud privacy_class gate (default on, plan 6.1) — never-send refuses; sensitive redacts
#QUILL_PRIVACY_CLOUD=1
# Approval binding at browser/desktop commit (default enforce, plan 0.4/5.2)
#QUILL_APPROVAL_BIND=enforce
# Global Personal Agent Layer planner (default on, plan 5.2)
#QUILL_PLANNER=1
# Core-workflow-only planner when QUILL_PLANNER=0 (default on)
#QUILL_PLANNER_CORE=1
# Drop Lance rows for dismissed/superseded/evidence_removed facts after N days
# (default 30), then optimize — plan 6.6 / 107 GB incident. Kill: QUILL_VECTOR_GC=0
#QUILL_VECTOR_GC=1
#QUILL_VECTOR_GC_DAYS=30
#QUILL_LANCE_OPTIMIZE_EVERY=500
# People v2 code default is ON after plan 2.3 golden (merge-error ≈ 0).
# Kill-switch / legacy resolver: QUILL_PEOPLE_V2=0
#QUILL_PEOPLE_V2=0
# Optional threshold overrides (defaults 0.92 / 0.15 / 0.85) — re-run
# scripts/eval_entity_resolution.py before loosening.
#QUILL_PEOPLE_AUTO_RESOLVE=0.92
#QUILL_PEOPLE_AUTO_MARGIN=0.15
#QUILL_PEOPLE_CREATE_NEW=0.85
# Context attribution (default on): facts minted during a titled meeting /
# focused window get origin="context" `about` edges to EXISTING entities
# named in the title (bind-only, never mints). Kill-switch:
#QUILL_CONTEXT_ATTRIB=0
#QUILL_FIELD_V2=0
# KG dual-write shadow (default on). Read cutover follows 7 clean parity
# reports; force with QUILL_KG_READ_V2=1 (or =0 to roll back).
# Parity also runs on a timer while shadow is on (default daily).
#QUILL_KG_SHADOW=1
#QUILL_KG_READ_V2=0
#QUILL_KG_PARITY_INTERVAL_S=86400
# Soak helper: python scripts/kg_cutover_soak.py
#QUILL_IDLE_TRAIN=0
#QUILL_ATTENTION_LEARN=0

# --- Notifications ---------------------------------------------------------------
#QUILL_PHONE_WATCH=0
#QUILL_NOTIFICATIONS=1
#QUILL_NOTIFICATIONS_PHONE_LINK_ONLY=1
#QUILL_NOTIFICATION_APPS=phone link
#QUILL_NOTIFICATION_POLL_S=2.5

# --- Audio quality (defaults are sensible; tune only if needed) -------------------
#QUILL_ASR_LANGUAGE=en
#QUILL_WHISPER_MODEL=medium
#QUILL_WHISPER_COMPUTE=int8
#QUILL_SPEAKERS=1
#QUILL_ECHO_DEDUP=1
# Mic device: empty = PortAudio default; integer index; or a name substring.
#QUILL_AUDIO_DEVICE=
# Camera: Linux default is v4l2 (falls back to any). Windows default is dshow.
#QUILL_CAMERA_BACKEND=v4l2
#QUILL_CAMERA_INDEX=0

# --- AI voice (TTS) -----------------------------------------------------------
# Spoken replies are on by default. Mute from the Voice chip (bottom-right) or
# Privacy — that persists without a restart. QUILL_TTS=off is the hard kill.
#QUILL_TTS=auto
#QUILL_TTS_SPEAK_REPLIES=1
#QUILL_TTS_VOICE=aria

# --- Pilot instrumentation, export, and updates -------------------------------
# Local usage ledger (WS-A): counts numbers only — how many searches, meetings,
# reviews — never what was said, searched or seen. Rows live in your own
# quill.db and nothing is sent anywhere unless you press "Send my stats" or
# turn on the weekly ping in Privacy controls (which also needs the URL below).
#QUILL_USAGE_LEDGER=1
#QUILL_USAGE_FLUSH_S=60
#QUILL_USAGE_PING_URL=
# Version check (WS-C): an unconditional GET of a static JSON file — no query
# params, no install id, no version header. Notification only; nothing is ever
# downloaded or installed automatically. Set to 0 to make no request at all.
#QUILL_UPDATE_CHECK=1
#QUILL_UPDATE_MANIFEST_URL=
# Export/backup (WS-B): refuse a backup projected to exceed this share of free
# disk. Secrets (.env, .credentials.env, data/.api_token) are never exported.
#QUILL_EXPORT_DISK_FRACTION=0.5
# Hybrid search (WS-E): exact substring matches enter ranking at this score
# floor so a codename or an unusual surname can't be buried by semantic
# neighbours. 0 on QUILL_SEARCH_HYBRID restores vector-first-with-fallback.
#QUILL_SEARCH_HYBRID=1
#QUILL_SEARCH_EXACT_FLOOR=0.55
