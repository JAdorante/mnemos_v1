# Mnemos — example configuration (safe defaults).
# Copy to .env and fill in your own keys. Never commit or zip a real .env.
#
# Every value here matches the safe code default unless noted. Uncommented
# lines are the only ones you must set. Capture, LAN exposure, and cloud
# spend all stay off or capped until you deliberately turn them on.
# One block departs from that rule and says so where it appears: the
# RECOMMENDED local-first stack, which is the tuned configuration a working
# install actually runs rather than the conservative code default.
# Tunables below are the feature-facing knobs; deeper calibration knobs
# (AQ_*, SPK_ENV_*, etc.) live in app/config.py and usually stay unset.

# --- Required -----------------------------------------------------------------
# Your own AI model account — Mnemos never ships with a key. Easiest path:
# connect it in Setup (/onboarding), which validates the key live and stores
# it in .credentials.env. Anthropic is the default parent and the only
# provider that also powers vision escalation + browser/desktop agent tasks;
# OpenAI / Gemini / Grok parents cover chat, extraction, and briefs.
ANTHROPIC_API_KEY=
# Pilot testers: if you were given an invite code instead of a key, the
# installer exchanges it here for a key of your own and writes it to
# .credentials.env. The key then lives on YOUR machine and calls go straight to
# the provider — this endpoint is never contacted again after install.
# (WS-D Tier 1; leave blank for the bring-your-own-key path.)
#QUILL_INVITE_URL=
# Or pick a different parent (anthropic | openai | google | xai) and set its key:
#QUILL_PARENT_PROVIDER=anthropic
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#XAI_API_KEY=
# Non-Anthropic parents map tasks onto the provider's flagship/light models;
# override with one forced model, or per tier:
#QUILL_PARENT_MODEL=
#QUILL_PARENT_MODEL_FLAGSHIP=
#QUILL_PARENT_MODEL_LIGHT=

# --- Network (loopback by default) ---------------------------------------------
# 127.0.0.1 = this machine only (safe default). Set 0.0.0.0 to allow phones /
# other devices on your LAN — if you do, you MUST also set QUILL_API_TOKEN,
# and unlock browsers at http://<lan-ip>:8000/auth.
#QUILL_HOST=127.0.0.1
#QUILL_PORT=8000
#QUILL_API_TOKEN=
# Optional salt for the browser session cookie HMAC (plan 6.3); auto-minted
# to data/.session_salt when unset. Cookie holds HMAC(salt, token), not the token.
#QUILL_SESSION_SALT=
# CSRF Origin/token gate on POST/PUT/PATCH/DELETE (plan 6.4; default on)
#QUILL_CSRF=1
#QUILL_DATA_DIR=data
#QUILL_CREDENTIALS_FILE=.credentials.env

# --- Capture (all OFF until in-UI consent) --------------------------------------
# Do not set these to 1 here. Turn capture on from Privacy controls in the UI,
# which records consent first. Setting them here silently records your screen,
# microphone, and meeting audio.
#QUILL_DESKTOP_CAPTURE=0
#QUILL_DESKTOP_CAPTURE_SCREEN=1
#QUILL_DESKTOP_CAPTURE_CLICKS=0
#QUILL_DESKTOP_CAPTURE_CLICK_VLM=0
#QUILL_SYSTEM_AUDIO=0
#QUILL_SYSTEM_AUDIO_DEVICE=
#QUILL_VISION=0
#QUILL_SAVE_AUDIO=0
#QUILL_EXTERNAL_CAPTURE=0

# --- Cloud spend ---------------------------------------------------------------
# Hard USD/day cap on ambient cloud calls (vision/extract/reflect/activity).
# 0 = uncapped (never recommended). User-initiated chat is not drawn from this.
#QUILL_CLOUD_BUDGET_USD_DAY=2.0
# Don't pay for cloud vision when the local model is down — skip the frame.
#QUILL_VISION_CLOUD_WHEN_LOCAL_DOWN=0

# --- Optional integrations ------------------------------------------------------
#GOOGLE_API_KEY=
# iCloud calendar (store user + app-password in .credentials.env via Setup)
#QUILL_ICLOUD_SYNC=1
#QUILL_ICLOUD_SYNC_S=1800

# --- Local-first text tier (requires Ollama) ------------------------------------
# With Ollama installed, answer/extract locally first and escalate to Claude
# only on low confidence. Leave off if you don't run Ollama.
#
# RECOMMENDED (departs from the code defaults below — copy these four lines
# into .env to run the local-first learning stack as it is actually tuned):
#
#   QUILL_TEXT_LOCAL=1
#   QUILL_TEXT_LOCAL_MODEL=qwen2.5:7b-instruct
#   QUILL_TEXT_ESCALATE_MIN_CONF=0.8
#   QUILL_ROUTER=shadow
#
# First: `ollama pull qwen2.5:7b-instruct` (~4.7 GB on disk at Q4, and roughly
# that much resident — it has to coexist with the vision model when both are
# warm, so check the card before assuming it fits).
# The model/threshold pair comes from a bench on 2026-07-17 (n~70 loo):
# qwen 0.65/0.66/0.24 vs llama3.2 0.55/0.47/0.37 — +19pt pass rate and a third
# fewer escalations for +0.4s p50. 0.8 is the quality-first bar while the local
# model earns trust; walk it toward 0.6 as the bench's pass rate rises, or set
# 0.99 for collection mode (escalate ~everything, to build a labeled set fast).
# Re-decide both together with scripts/bench_bakeoff.py — it prints the winning
# QUILL_TEXT_LOCAL_MODEL + QUILL_TEXT_ESCALATE_MIN_CONF at matched risk, and
# flipping the model while keeping the old threshold voids that guarantee.
# Rollback for any swap is the previous pair of values, nothing else.
#
# Code defaults (conservative — the tier is simply off):
#QUILL_TEXT_LOCAL=1
#QUILL_TEXT_LOCAL_MODEL=llama3.2
#QUILL_TEXT_ESCALATE_MIN_CONF=0.6
#QUILL_TEXT_LOCAL_TIMEOUT_S=45
#QUILL_TEXT_FEWSHOT_K=3
#QUILL_TEXT_FEWSHOT_MIN_SIM=0.4
#QUILL_TEXT_FEWSHOT_CONF_WEIGHT=0.85
#QUILL_TEXT_HIGH_STAKES_TASKS=plan
# Prompt size above which the local tier is skipped and Claude answers.
# A small model handed a whole attached document answers fluently from
# the fraction it held and self-reports high confidence, so no post-hoc
# gate catches it — length is the only signal available beforehand.
# Ordinary grounded chat is ~5-6k here, so this only buys the parent for
# document-sized turns. 0 disables the guard.
#QUILL_TEXT_LOCAL_MAX_PROMPT_CHARS=12000
#QUILL_OLLAMA_URL=http://127.0.0.1:11434
#QUILL_OLLAMA_KEEP_ALIVE=30m
#QUILL_OLLAMA_WARMUP=0
# Exemplar store (production few-shot from verified answers). Off until the
# store has rows; bakeoff --arms exemplars once QUILL_EXEMPLARS=1.
#QUILL_EXEMPLARS=0
#QUILL_EXEMPLAR_K=3
#QUILL_EXEMPLAR_MIN_SIM=0.75
# Distill trail + unified learning harvest (local only)
#QUILL_ESCALATE_LOG=1
#QUILL_DISTILL_FULL=1
#QUILL_LEARNING=1
#QUILL_LEGACY_DISTILL=1
# Idle shadow re-grade of non-escalated local outputs (costs cloud tokens).
# This is the only AUTOMATIC source of "the local answer was fine" labels —
# an `agree` grade trains the router's local_sufficient=1 class, which human
# review of the escalation backlog cannot produce (those are all the other
# class). One run per calendar day; BATCH is the throughput/spend knob.
#QUILL_SHADOW_EVAL=0
#QUILL_SHADOW_BATCH=20
#QUILL_SHADOW_BUDGET_TOKENS=250000
# How far back the sampler may reach for ungraded rows. Was hard-coded to 24h,
# which threw labels away: at one run per day grading BATCH rows, any busier
# day's surplus aged out before the next run could reach it and no backlog
# could ever be drained. Raise BATCH to drain faster; this only decides what
# is still reachable. Dedupe memory is pruned to the window, so nothing in it
# is ever graded (or paid for) twice.
#QUILL_SHADOW_LOOKBACK_DAYS=30
# Trained escalation router: off | shadow | active. `shadow` logs the model's
# decisions next to the heuristic's (data/router/shadow_log.jsonl) with zero
# routing influence — run it there for a week and promote to `active` only if
# the weekly report beats the heuristic. Rollback from active is `shadow`.
#
# Turn this to `shadow` EARLY, before you have any use for the predictions.
# Retrieval features (max/mean chunk cosine, chunk count, entity coverage) are
# measured per call and recorded on the row from the moment this leaves `off`,
# and they cannot be reconstructed later — retrieval is nondeterministic as the
# memory store grows, so a replayed value is a different feature than the one
# production saw. Every day spent at `off` is a day of training rows you do not
# get back. Needs QUILL_TEXT_LOCAL=1: with no local tier there is nothing to
# route, and nothing is logged.
#
# What it needs before it can fit anything: QUILL_ROUTER_MIN_LABELS verdicts
# (👍/👎/✏️ on chat answers, fact review, or shadow-eval grades). Check where
# you stand with `python scripts/distill_label.py list`. Retraining rides the
# idle-trainer tick — machine idle >= QUILL_IDLE_TRAIN_IDLE_MIN and on AC — and
# does NOT require QUILL_IDLE_TRAIN=1; that flag gates LoRA training only.
#QUILL_ROUTER=off
#QUILL_ROUTER_T_LOW=0.25
#QUILL_ROUTER_T_HIGH=0.6
# Labels required before the first fit, and new labels required per retrain.
#QUILL_ROUTER_MIN_LABELS=50
#QUILL_ROUTER_RETRAIN_LABELS=25
#QUILL_ROUTER_DIR=data/router
# Fast classifier heads below the local LLM: off | shadow | active
#QUILL_HEADS=off
#QUILL_HEADS_T_LOW=0.10
#QUILL_HEADS_T_HIGH=0.60
# Idle LoRA / distill training when the machine is quiet
#QUILL_IDLE_TRAIN=0
# Stage-level latency spans (measure before optimizing; off by default)
#QUILL_LATENCY_SPANS=0

# --- Local vision (Ollama VLM) --------------------------------------------------
#QUILL_VISION_LOCAL=1
#QUILL_VISION_LOCAL_MODEL=minicpm-v
#QUILL_VISION_LOCAL_TIMEOUT_S=25
#QUILL_VISION_LOCAL_COOLDOWN_S=120
#QUILL_VISION_ESCALATE_MIN_CONF=0.6
#QUILL_VISION_ESCALATE_MIN_CAPTURE=0.6
#QUILL_VISION_MODEL=claude-opus-4-8
#QUILL_VISION_FALLBACK_MODEL=claude-haiku-4-5

# --- Feature flags --------------------------------------------------------------
# Tester cohort preset: meeting-first, Phone Link / anticipate / desktop off.
#QUILL_PROFILE=tester
#QUILL_FIRST_RUN_MODE=meeting
#QUILL_MEETING_PAD_MIN=5
#QUILL_UNLOCK_AFTER_BRIEFS=3
# Research answers → durable memory (default on). Sync so a follow-up
# "using only your memory" question in the same test sees the facts.
#QUILL_RESEARCH_INGEST=1
#QUILL_RESEARCH_INGEST_SYNC=1
#QUILL_RESEARCH_INGEST_MIN_CHARS=40
# Meeting window auto-session (calendar-driven capture pad)
#QUILL_MEETING_SESSION=1
# Gmail/Calendar metadata cold-start (headers + attendees only — never bodies)
#QUILL_EXHAUST_INGEST=1
#QUILL_EXHAUST_DAYS=90
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
# Read-only MCP memory server for Claude Desktop (see docs/mcp.md)
#QUILL_MCP=0
# Cloud privacy_class gate (default on, plan 6.1) — never-send refuses; sensitive redacts
#QUILL_PRIVACY_CLOUD=1
# Approval binding at browser/desktop commit: enforce | shadow | off
#QUILL_APPROVAL_BIND=enforce
# Global Personal Agent Layer planner (default on, plan 5.2)
#QUILL_PLANNER=1
# Core-workflow-only planner when QUILL_PLANNER=0 (default on)
#QUILL_PLANNER_CORE=1
# Browser agent (QUILL_AGENT=0 disables /chat agent path)
#QUILL_AGENT_PROFILE=main
#QUILL_AGENT_CHANNEL=
#QUILL_AGENT_HEADLESS=0
# Drop Lance rows for dismissed/superseded/evidence_removed facts after N days
# (default 30), then optimize — plan 6.6 / 107 GB incident. Kill: QUILL_VECTOR_GC=0
#QUILL_VECTOR_GC=1
#QUILL_VECTOR_GC_DAYS=30
#QUILL_LANCE_OPTIMIZE_EVERY=500
# People v2 code default is ON after plan 2.3 golden (merge-error ≈ 0).
# Kill-switch / legacy resolver: QUILL_PEOPLE_V2=0
#QUILL_PEOPLE_V2=1
# Optional threshold overrides (defaults 0.92 / 0.15 / 0.85) — re-run
# scripts/eval_entity_resolution.py before loosening.
#QUILL_PEOPLE_AUTO_RESOLVE=0.92
#QUILL_PEOPLE_AUTO_MARGIN=0.15
#QUILL_PEOPLE_CREATE_NEW=0.85
# People v3 (default OFF — opt in after soak)
#QUILL_PEOPLE_ESCROW=0
#QUILL_MINT_RECURRENCE=0
#QUILL_MINT_RECURRENCE_SESSIONS=2
#QUILL_PROVISIONAL_BIND=0
#QUILL_SCORE_SHADOW=0
#QUILL_SCORE_V2=0
# Context attribution (default on): facts minted during a titled meeting /
# focused window get origin="context" `about` edges to EXISTING entities
# named in the title (bind-only, never mints). Kill-switch:
#QUILL_CONTEXT_ATTRIB=0
# Field / working memory / horizon (attention surfaces)
#QUILL_FIELD_V2=0
#QUILL_WM=1
#QUILL_HORIZON=1
#QUILL_ATTENTION_LEDGER=1
#QUILL_ATTENTION_LEARN=0
# KG dual-write shadow (default on). Read cutover follows 7 clean parity
# reports; force with QUILL_KG_READ_V2=1 (or =0 to roll back).
# Parity also runs on a timer while shadow is on (default daily).
#QUILL_KG_SHADOW=1
#QUILL_KG_READ_V2=0
#QUILL_KG_PARITY_INTERVAL_S=86400
# Soak helper: python scripts/kg_cutover_soak.py
# Memory economy (observe on; compaction mutates — keep off until trusted)
#QUILL_MEMORY_ECONOMY=1
#QUILL_COMPACTION=0
# Likely-next suggestions (off by default; quiet when on)
#QUILL_ANTICIPATE=0
# Multitask / concurrent agent jobs
#QUILL_MULTITASK=1
# Triggers (proactive offers from memory patterns)
#QUILL_TRIGGERS=1

# --- Perception (desktop L0–L3) -------------------------------------------------
# L0 metadata is on with perception. L1 OCR replaces the VLM screen producer
# when flipped; L3 async semantics stays off until soak.
#QUILL_PERCEPTION=1
#QUILL_PERCEPTION_L1=0
#QUILL_PERCEPTION_L2=1
#QUILL_PERCEPTION_L3=0

# --- Phone / peer / org ---------------------------------------------------------
# Direct phone → Mnemos HTTP channel (Shortcuts / Android HTTP shortcut)
#QUILL_PHONE_CHANNEL=1
#QUILL_PHONE_WATCH=0
# Mnemos ↔ Mnemos peer asks (default: human disclosure verdict)
#QUILL_PEER_CHANNEL=1
#QUILL_PEER_AUTO_ANSWER=0
#QUILL_PEER_REQUIRE_TLS=0
# Org AI Network node (OFF until coordinator + tokens are set)
#QUILL_ORG_NETWORK=0
#QUILL_ORG_COORDINATOR_URL=http://127.0.0.1:8100
#QUILL_ORG_NODE_ID=
#QUILL_ORG_NODE_TOKEN=
#QUILL_ORG_ROLE=ic
#QUILL_ORG_DISPLAY_NAME=
#QUILL_ORG_REPORTS_TO=

# --- Notifications ---------------------------------------------------------------
#QUILL_NOTIFICATIONS=1
#QUILL_NOTIFICATIONS_PHONE_LINK_ONLY=1
#QUILL_NOTIFICATION_APPS=phone link
#QUILL_NOTIFICATION_POLL_S=2.5

# --- Audio / ASR quality --------------------------------------------------------
# Defaults are sensible; bump Whisper size + beam for max-quality meetings.
# Which engine transcribes. `whisper` is the default and the rollback target
# for every later engine — set it back and restart to undo a swap.
#QUILL_ASR_ENGINE=whisper
# Word-level timings on every transcript. Off for Whisper (it costs real time
# there); engines that emit them natively make this free.
#QUILL_ASR_WORD_TIMESTAMPS=0
#QUILL_ASR_LANGUAGE=en
#QUILL_WHISPER_MODEL=small
#QUILL_WHISPER_COMPUTE=int8
#QUILL_WHISPER_DEVICE=cpu
#QUILL_WHISPER_BEAM_SIZE=1
#QUILL_WHISPER_TEMPERATURE=0
#QUILL_ASR_CONDITION_PREVIOUS=1
#QUILL_WHISPER_CPU_THREADS=0
#QUILL_WHISPER_NUM_WORKERS=1
#QUILL_ASR_MAX_UTTERANCE_S=0
# Session-aware ASR biasing (names/projects from the KG + recent turns)
#QUILL_ASR_BIAS=1
#QUILL_ASR_BIAS_RECENT_TURNS=4
#QUILL_SPEAKERS=1
#QUILL_ECHO_DEDUP=1
# Pre-ASR quality scoring + denoise (spectral ASR path off by default)
#QUILL_AUDIO_QUALITY=1
#QUILL_DENOISE_BACKEND=auto
#QUILL_DENOISE_SPECTRAL_ASR=0
#QUILL_INGEST_FILTER=1
# Mic device: empty = PortAudio default; integer index; or a name substring.
#QUILL_AUDIO_DEVICE=
# Camera: Linux default is v4l2 (falls back to any). Windows default is dshow.
#QUILL_CAMERA_BACKEND=v4l2
#QUILL_CAMERA_INDEX=0

# --- AI voice (TTS) -----------------------------------------------------------
# Spoken replies are on by default. Mute from the Voice chip (bottom-right) or
# Privacy — that persists without a restart. QUILL_TTS=off is the hard kill.
#QUILL_TTS=auto
#QUILL_TTS_SPEAK_REPLIES=1
#QUILL_TTS_VOICE=aria

# --- Onboarding / documents ---------------------------------------------------
#QUILL_ONBOARDING=1
#QUILL_ONBOARDING_SCAN=1
# Documents scan is explicit opt-in in the wizard (content read)
#QUILL_DOCUMENTS=1
# Per-file text cap for BOTH the folder scan and a chat attachment.
#QUILL_DOCUMENTS_MAX_CHARS=40000
# How much of an attached file rides along in the chat turn right after
# the upload. Fact mining reads the whole text in the background, but
# "what is this document about?" is answered from this window alone.
#QUILL_ATTACH_CONTEXT_CHARS=16000

# --- Pilot instrumentation, export, and updates -------------------------------
# Local usage ledger (WS-A): counts numbers only — how many searches, meetings,
# reviews — never what was said, searched or seen. Rows live in your own
# quill.db and nothing is sent anywhere unless you press "Send my stats" or
# turn on the weekly ping in Privacy controls (which also needs the URL below).
#QUILL_USAGE_LEDGER=1
#QUILL_USAGE_FLUSH_S=60
#QUILL_USAGE_PING_URL=
# Version check (WS-C): an unconditional GET of a static JSON file — no query
# params, no install id, no version header. Notification only; nothing is ever
# downloaded or installed automatically. Set to 0 to make no request at all.
#QUILL_UPDATE_CHECK=1
#QUILL_UPDATE_MANIFEST_URL=
# Export/backup (WS-B): refuse a backup projected to exceed this share of free
# disk. Secrets (.env, .credentials.env, data/.api_token) are never exported.
#QUILL_EXPORT_DISK_FRACTION=0.5
# Hybrid search (WS-E): exact substring matches enter ranking at this score
# floor so a codename or an unusual surname can't be buried by semantic
# neighbours. 0 on QUILL_SEARCH_HYBRID restores vector-first-with-fallback.
#QUILL_SEARCH_HYBRID=1
#QUILL_SEARCH_EXACT_FLOOR=0.55
#QUILL_SEMANTIC=1
#QUILL_EMBEDDING_MODEL=all-MiniLM-L6-v2
